### BiasLens example environment variables
# Copy to .env and update values before running locally or in CI.

SECRET_KEY=
DATABASE_PATH=users.db
UPLOAD_DIR=uploads
NVIDIA_API_KEY=
GEMINI_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_JSON=

# Docker/Build
DOCKER_REGISTRY=ghcr.io
DOCKER_IMAGE_NAME=biaslens
